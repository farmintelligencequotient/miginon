# Copy this file to .env and fill in real values - .env is gitignored and
# should never contain real secrets in version control.
# In development you can leave EMAIL_BACKEND as the console backend and
# every email (OTP codes, welcome, reports, etc.) will just print to the
# terminal instead of actually sending.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. In production this is set automatically
# by the Vercel Postgres/Neon integration - format:
# postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ZeptoMail (Zoho's transactional email service - separate from a regular
# Zoho Mail mailbox, built for automated app sending like OTPs). Create a
# Mail Agent in the ZeptoMail console and generate an SMTP API key there;
# EMAIL_HOST_USER is always the literal string "emailapikey", not an email
# address - EMAIL_HOST_PASSWORD is the generated API key.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=FarmIQ <noreply@farmiq.solutions>

# Web Push (device/browser notifications). Generate a keypair once with
# py-vapid (installed as a pywebpush dependency) and paste it here - the
# same pair works across local dev and production, so this only needs
# doing once per deployment, not per environment.
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_ADMIN_EMAIL=admin@farmiq.solutions

# Hedera Hashgraph. HEDERA_OPERATOR_ID/HEDERA_OPERATOR_KEY are your admin
# account's credentials (testnet to start - see portal.hedera.com) - this one
# account pays every fee and holds every mint. NEVER commit real values here
# or paste them anywhere outside your local .env - if a key is ever pasted
# into chat, a commit, or anywhere else, treat it as compromised and
# generate a fresh one. The platform's shared token/topic IDs are NOT
# secrets and are created automatically on first use, stored in the
# database (blockchain.HederaConfig) - there's nothing to set for those.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=change-me
HEDERA_OPERATOR_KEY=change-me

# TomTom Maps (GeoMap module - boundary/field surveying page). Build a
# custom vector style in TomTom Maps Maker (maps.tomtom.com), then take the
# id segment out of its style JSON URL:
#   https://api.tomtom.com/style/2/custom/style/<TOMTOM_STYLE_ID>.json?key=...
# and your API key from the TomTom developer portal.
TOMTOM_API_KEY=change-me
TOMTOM_STYLE_ID=change-me

# WhatsApp notifications (Meta Cloud API - business.facebook.com). Create a
# WhatsApp Business app, get a phone number ID and a permanent access token.
# Free-form text only works within 24h of the recipient messaging your
# number first; outside that window you need an approved message template.
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_API_VERSION=v20.0

# S3 image storage (farm site photos, and any future upload). Leave
# AWS_STORAGE_BUCKET_NAME blank to fall back to local disk (MEDIA_ROOT) - fine
# for local dev, but Vercel's filesystem is ephemeral, so production needs a
# real bucket for uploads to survive a redeploy. AWS_S3_CUSTOM_DOMAIN is
# optional - set it if the bucket sits behind a CDN/custom domain, otherwise
# leave blank to use the bucket's default S3 URL.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=