# Copy this file to .env and fill in real values - .env is gitignored and
# should never contain real secrets in version control.
# In development you can leave EMAIL_BACKEND as the console backend and
# every email (OTP codes, welcome, reports, etc.) will just print to the
# terminal instead of actually sending.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. In production this is set automatically
# by the Vercel Postgres/Neon integration - format:
# postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ZeptoMail (Zoho's transactional email service - separate from a regular
# Zoho Mail mailbox, built for automated app sending like OTPs). Create a
# Mail Agent in the ZeptoMail console and generate an SMTP API key there;
# EMAIL_HOST_USER is always the literal string "emailapikey", not an email
# address - EMAIL_HOST_PASSWORD is the generated API key.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=FarmIQ <noreply@farmiq.solutions>

# Web Push (device/browser notifications). Generate a keypair once with
# py-vapid (installed as a pywebpush dependency) and paste it here - the
# same pair works across local dev and production, so this only needs
# doing once per deployment, not per environment.
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_ADMIN_EMAIL=admin@farmiq.solutions
